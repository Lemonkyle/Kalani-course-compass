# Browser-safe values. These are used by the Vite frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only value. Never rename this with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# Generated by npm run admin:setup. These never go to the browser.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
